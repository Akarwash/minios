# macOS
.DS_Store

# Build artifacts
*.o
townos.elf
townos.bin

# User programs, built separately and copied onto the disk image. The second
# pattern is needed as well as the first: `user/*.ELF` does NOT match a
# subdirectory, so without it the test fixtures' binaries get committed as source.
user/*.ELF
user/tests/*.ELF

# Disk image for the ATA driver (generated by make)
disk.img

# Pre-test backup of the disk image. The writable-FAT32 work can damage on-disk
# state that outlives the code fix (a corrupt FAT stays corrupt), so a known-good
# copy is kept to restore from between destructive tests. Not build output, not
# committed: it is a local safety net.
disk.img.known-good

# Test file generated by make and copied onto the disk image on every `make run`.
# Generated rather than committed: it is 40KB of padding whose entire content is
# described by three lines of the rule that writes it.
HUGE.TXT

# Per-tranche scratch checklist, never committed and deleted when the tranche ends.
LOOSE-ENDS-TASK.md
FD-PIPES-TASK.md
PIPE-FOLLOWUPS-TASK.md

# Per-tranche scratch checklist for the signals rung, never committed.
SIGNALS-TASK.md
